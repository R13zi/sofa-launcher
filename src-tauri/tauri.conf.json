{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sofa",
  "version": "0.7.0",
  "identifier": "app.sofa.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sofa",
        "fullscreen": true,
        "decorations": false,
        "resizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: https://shared.akamai.steamstatic.com https://cdn.akamai.steamstatic.com https://cdn1.epicgames.com https://cdn2.unrealengine.com; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE5NjlDMDkxRkE1MTgzODcKUldTSGcxSDZrY0JwR2RaaldiT2U2UEU3OThiMzdGdUR1VUJQcWxWU2NjQ1ltQit3MDFsWjdIaUEK",
      "endpoints": ["https://github.com/R13zi/sofa-launcher/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
